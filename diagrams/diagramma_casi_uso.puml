@startuml Diagramma_dei_casi_duso
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Pescatore" as Pescatore <<umano>> <<primario>> <<attivo>>
actor "Servizio Meteo" as Meteo <<non-umano>> <<secondario>> <<passivo>>
actor "Servizio Storage" as Storage <<non-umano>> <<secondario>> <<passivo>>

rectangle "Diario di Pesca" {
  ' --- nuovi casi uso ---
	usecase "Disegno tratto" as UC_DisegnoTratto
	usecase "Elimina pescata" as UC_EliminaPescata
	usecase "Inserisci caratteristica" as UC_NuovaCaratteristica
	usecase "Nuova esca" as UC_InserisciEsca
	usecase "Allega esca" as UC_AllegaEsca
	usecase "Scrive obiettivi" as UC_NuovoObiettivo
	usecase "Previsioni meteo" as UC_Previsioni
	usecase "Inserimento nuovo spot" as UC_NuovoSpot
	usecase "Modifica spot" as UC_ModificaSpot
	usecase "Scegli spot" as UC_SceltaSpot
	usecase "Osserva statistiche" as UC_Statistiche
	usecase "Elimina spot" as UC_EliminaSpot
	usecase "Backup dati" as UC_Backup
	usecase "Ripristino dati" as UC_Ripristino
	usecase "Nuova pescata" as UC_NuovaPescata
	usecase "Pianificazione pescata" as UC_Pianificazione
	usecase "Nuova cattura ricordo" as UC_CatturaMemorabile
	usecase "Aggiungi categoria spot" as UC_NuovaClassificazione
	usecase "Nuovo territorio" as UC_NuovaValle
	
  

  ' --- nuove associazioni ---
	UC_NuovoSpot ..> UC_DisegnoTratto : <<include>>
	UC_DisegnoTratto ..> UC_ModificaSpot : <<extend>>
	UC_NuovaPescata ..> UC_SceltaSpot : <<include>>
	UC_Previsioni ..> UC_Pianificazione : <<extend>>
	UC_Pianificazione ..> UC_SceltaSpot : <<include>>
	UC_NuovaCaratteristica ..> UC_NuovoObiettivo : <<extend>>  
	UC_InserisciEsca ..> UC_AllegaEsca : <<extend>>
	UC_AllegaEsca ..> UC_NuovaPescata : <<extend>>
  


  ' --- Regola di business, l'eliminazione da parte del pescatore dello spot elimina anche il tratto associato e viceversa ---
}

' --- associazioni con attori ---
	Meteo --> UC_Previsioni
	Storage --> UC_Backup
	Storage --> UC_Ripristino
	Pescatore --> UC_NuovoSpot
	Pescatore --> UC_InserisciEsca
	Pescatore --> UC_ModificaSpot
	Pescatore --> UC_SceltaSpot
	Pescatore --> UC_EliminaSpot
	Pescatore --> UC_Statistiche
	Pescatore --> UC_Backup
	Pescatore --> UC_Ripristino
	Pescatore --> UC_EliminaPescata 
	Pescatore --> UC_DisegnoTratto
	Pescatore --> UC_CatturaMemorabile
	Pescatore --> UC_NuovaCaratteristica
	Pescatore --> UC_NuovaPescata
	Pescatore --> UC_Pianificazione
	Pescatore --> UC_NuovoObiettivo
	Pescatore --> UC_Previsioni
	Pescatore --> UC_NuovaClassificazione
	Pescatore --> UC_NuovaValle

@enduml
